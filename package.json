{
  "name": "dsh-dsglm-only",
  "version": "0.1.0",
  "type": "module",
  "description": "Adds a provider route that lists only DeepSeek and Zhipu GLM models, merged across the channels dsh-providers-hub exposes, with per-request failover between them.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node test/unit.test.mjs",
    "test:live": "node test/plugin.test.mjs && node test/catalog.test.mjs && node test/stream.test.mjs && node test/fallback.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "glm",
    "zhipu",
    "model-catalog",
    "provider"
  ],
  "author": "yyh39766",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyh39766/dsh-dsglm-only.git"
  },
  "homepage": "https://github.com/yyh39766/dsh-dsglm-only#readme",
  "bugs": {
    "url": "https://github.com/yyh39766/dsh-dsglm-only/issues"
  }
}
